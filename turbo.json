{
	"$schema": "https://turbo.build/schema.json",
	"ui": "stream",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".output/**"]
		},
		"lint": {
			"dependsOn": []
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["^build"],
			"env": ["DATABASE_URL", "DATABASE_ADMIN_URL", "HURIRO_TESTCONTAINERS"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"gen": {
			"dependsOn": ["^build"],
			"outputs": [".env.example"]
		},
		"gen:check": {
			"dependsOn": []
		}
	}
}
