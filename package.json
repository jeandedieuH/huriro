{
	"name": "huriro",
	"version": "0.0.0",
	"private": true,
	"description": "Huriro — a secure, scalable, modular workspace platform (server + apps: AGPL-3.0, SDK/CLI: MIT)",
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"engines": {
		"bun": ">=1.4.5",
		"node": ">=24.22.3"
	},
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"lint": "turbo lint",
		"typecheck": "turbo typecheck",
		"test": "turbo test",
		"gen": "turbo run gen",
		"gen:check": "turbo run gen:check",
		"check:boundaries": "dependency-cruiser apps packages --config packages/config/dependency-cruiser.cjs",
		"check:licenses": "bun scripts/check-licenses.ts",
		"smoke:compose": "bun scripts/compose-smoke.ts",
		"verify": "turbo lint typecheck test build gen:check && bun run check:boundaries && bun run check:licenses",
		"migrate": "bun --cwd apps/server src/index.ts migrate",
		"doctor": "bun --cwd apps/server src/index.ts doctor"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@types/bun": "1.4.4",
		"dependency-cruiser": "18.8.0",
		"turbo": "2.11.11",
		"typescript": "^7.1.0-beta"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
		"vitest": "5.1.0"
	},
	"packageManager": "bun@1.4.5"
}
