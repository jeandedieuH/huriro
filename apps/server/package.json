{
	"name": "@huriro/server",
	"version": "0.0.0",
	"private": true,
	"description": "One image, three roles: api | worker | realtime (ADR-0018)",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"dependencies": {
		"@elysia/openapi": "2.0.0-rc.1",
		"@huriro/contracts": "workspace:*",
		"@huriro/db": "workspace:*",
		"@huriro/domain": "workspace:*",
		"elysia": "2.0.0-rc.3",
		"pg-boss": "12.38.2",
		"pino": "10.4.0",
		"prom-client": "15.1.3",
		"postgres": "4.1.1",
		"typebox": "1.4.7"
	},
	"scripts": {
		"dev": "bun --watch src/index.ts serve --role=all",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "bun test",
		"build": "bun build src/index.ts --outdir dist --target bun",
		"gen": "bun src/cli/genenv.ts",
		"gen:check": "bun src/cli/genenv.ts --check"
	}
}
