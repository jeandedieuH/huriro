{
	"name": "@huriro/server",
	"version": "0.0.0",
	"private": true,
	"description": "One image, three roles: api | worker | realtime (ADR-0018)",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"dependencies": {
		"@better-auth/cimd": "1.7.25",
		"@better-auth/drizzle-adapter": "1.7.25",
		"@better-auth/mcp": "1.7.25",
		"@better-auth/oauth-provider": "1.7.25",
		"@better-auth/passkey": "1.7.25",
		"@elysia/openapi": "2.0.0-rc.1",
		"@emailit/node": "^2.0.4",
		"@hocuspocus/server": "4.8.0",
		"@huriro/agent-tools": "workspace:*",
		"@huriro/contracts": "workspace:*",
		"@huriro/db": "workspace:*",
		"@huriro/domain": "workspace:*",
		"@huriro/editor": "workspace:*",
		"@huriro/env": "workspace:*",
		"@modelcontextprotocol/server": "2.4.0",
		"axios": "^1.21.1",
		"better-auth": "1.7.25",
		"elysia": "2.0.0-rc.3",
		"imapflow": "^2.12.1",
		"lib0": "0.2.120",
		"nodemailer": "^10.6.0",
		"pg-boss": "12.38.2",
		"pino": "10.4.0",
		"postal-mime": "^4.2.1",
		"postgres": "4.1.1",
		"prom-client": "15.1.3",
		"react": "19.1.1",
		"react-dom": "19.1.1",
		"react-email": "^6.11.16",
		"resend": "^6.39.0",
		"typebox": "1.4.7",
		"y-protocols": "1.0.7",
		"yjs": "13.6.33",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@hocuspocus/provider": "4.8.0",
		"@huriro/cli": "workspace:*",
		"@huriro/test-utils": "workspace:*",
		"@types/react": "19.1.13",
		"@types/react-dom": "19.1.9"
	},
	"scripts": {
		"dev": "bun --watch src/index.ts serve --role=all",
		"email:dev": "email dev --dir src/email/templates",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "bun test --timeout 30000",
		"build": "bun build src/index.ts --outdir dist --target bun",
		"gen": "bun src/cli/genenv.ts && bun src/cli/genapi.ts",
		"gen:check": "bun src/cli/genenv.ts --check && bun src/cli/genapi.ts --check"
	}
}
