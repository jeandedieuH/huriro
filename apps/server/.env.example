# GENERATED by `huriro genenv` — edit packages/env/server, never this file.

# Public base URL, e.g. https://app.example.com
HURIRO_URL=http://localhost:3000

# Public hostname (Caddyfile/ingress). Set by `huriro init`.
HURIRO_DOMAIN=

# development | production | test
HURIRO_ENV=development

# Cloud-only code paths (billing, abuse controls) require `cloud` (§2.5)
HURIRO_MODE=selfhost

# postgres://… as role huriro_app (or use _FILE)
DATABASE_URL=

# Path to file containing DATABASE_URL (Docker secret)
DATABASE_URL_FILE=

# postgres://… privileged role for migrations/pg-boss/CLI
DATABASE_ADMIN_URL=

DATABASE_ADMIN_URL_FILE=

# postgres://… as role huriro_auth — identity/session lookups only
DATABASE_AUTH_URL=

DATABASE_AUTH_URL_FILE=

# Cookie/session signing secret (≥32 chars); falls back to HKDF of HURIRO_SECRET_KEY
BETTER_AUTH_SECRET=

BETTER_AUTH_SECRET_FILE=

# WebAuthn relying-party id — defaults to HURIRO_URL hostname
PASSKEY_RP_ID=

# Shown in the authenticator prompt
PASSKEY_RP_NAME=Huriro

# Allowed passkey origin(s), comma-separated — defaults to HURIRO_URL
PASSKEY_ORIGIN=

# Google OAuth client ID (enables Sign in with Google when paired with secret)
GOOGLE_CLIENT_ID=

# Google OAuth client secret (or use _FILE)
GOOGLE_CLIENT_SECRET=

# Path to file containing GOOGLE_CLIENT_SECRET (Docker secret)
GOOGLE_CLIENT_SECRET_FILE=

# GitHub OAuth app client ID (enables Sign in with GitHub when paired with secret)
GITHUB_CLIENT_ID=

# GitHub OAuth app client secret (or use _FILE)
GITHUB_CLIENT_SECRET=

# Path to file containing GITHUB_CLIENT_SECRET (Docker secret)
GITHUB_CLIENT_SECRET_FILE=

# Apple Services ID (enables Sign in with Apple when paired with secret)
APPLE_CLIENT_ID=

# Apple client secret JWT (or use _FILE)
APPLE_CLIENT_SECRET=

# Path to file containing APPLE_CLIENT_SECRET (Docker secret)
APPLE_CLIENT_SECRET_FILE=

# Optional iOS/macOS bundle ID for native Sign in with Apple
APPLE_APP_BUNDLE_IDENTIFIER=

# Root key; per-purpose keys derived via HKDF
HURIRO_SECRET_KEY=

HURIRO_SECRET_KEY_FILE=

# fs (local volume) | s3
BLOB_STORE=fs

# Filesystem blob root when BLOB_STORE=fs
BLOB_DIR=/var/lib/huriro/files

S3_ENDPOINT=

S3_BUCKET=

S3_ACCESS_KEY=

S3_SECRET_KEY=

# HTTP port for the api role
PORT=3001

# WebSocket port for the realtime role
WS_PORT=3005

LOG_LEVEL=info

# OTLP collector endpoint; unset = no tracing export
OTEL_ENDPOINT=

# GlitchTip/Sentry DSN; unset = no error reporting
ERROR_DSN=

# Dead-man-switch URL the worker pings on job health
HEARTBEAT_URL=

# Optional ClamAV daemon host for attachment quarantine scanning
CLAMAV_HOST=

# ClamAV daemon TCP port
CLAMAV_PORT=3310

# Optional SMTP relay URL for notification email digests
SMTP_URL=

# Sender address for notification email digests
SMTP_FROM=noreply@huriro.local

# Web Push VAPID public key (base64url P-256)
VAPID_PUBLIC_KEY=

# Web Push VAPID private key (or use _FILE)
VAPID_PRIVATE_KEY=

# Path to file containing VAPID_PRIVATE_KEY (Docker secret)
VAPID_PRIVATE_KEY_FILE=

# Web Push VAPID contact subject URI
VAPID_SUBJECT=mailto:admin@huriro.local

# GitHub App numeric ID for two-way issue sync
GITHUB_APP_ID=

# GitHub App PEM private key (or use _FILE)
GITHUB_APP_PRIVATE_KEY=

# Path to file containing GITHUB_APP_PRIVATE_KEY (Docker secret)
GITHUB_APP_PRIVATE_KEY_FILE=

# GitHub App inbound webhook HMAC secret (or use _FILE)
GITHUB_APP_WEBHOOK_SECRET=

# Path to file containing GITHUB_APP_WEBHOOK_SECRET (Docker secret)
GITHUB_APP_WEBHOOK_SECRET_FILE=

# Domain used for generated inbound-parse addresses, e.g. in.example.com
MAIL_INBOUND_DOMAIN=

# Hard cap on raw MIME size accepted by inbound parse/provider sync
MAIL_MAX_MESSAGE_BYTES=52428800

# Default undo-send window for outbound replies
MAIL_UNDO_SEND_SECONDS=10

# Worker-side MIME parse/sanitize time budget per message
MAIL_PARSE_TIMEOUT_MS=5000

# Poll interval for IMAP/Graph accounts and Gmail backstop sync
MAIL_SYNC_INTERVAL_SECONDS=60

# Google OAuth client ID for Gmail mail accounts (falls back to GOOGLE_CLIENT_ID)
GMAIL_CLIENT_ID=

# Google OAuth client secret for mail (or use _FILE)
GMAIL_CLIENT_SECRET=

# Path to file containing GMAIL_CLIENT_SECRET (Docker secret)
GMAIL_CLIENT_SECRET_FILE=

# Microsoft Entra app client ID for Graph mail
MICROSOFT_CLIENT_ID=

# Microsoft Entra client secret (or use _FILE)
MICROSOFT_CLIENT_SECRET=

# Path to file containing MICROSOFT_CLIENT_SECRET (Docker secret)
MICROSOFT_CLIENT_SECRET_FILE=

# Per-principal tool calls per minute
AGENT_CALLS_PER_MINUTE=60

# Per-principal concurrent tool calls
AGENT_MAX_CONCURRENT=4

# Per-credential read result bytes per rolling hour
AGENT_READ_BYTES_PER_HOUR=5242880

# Global read-only maintenance mode (writes return 503, reads keep serving, §20.3)
HURIRO_READ_ONLY=false

# Optional Valkey/Redis URL for multi-replica realtime signal + presence pub/sub
VALKEY_URL=

# Per-actor/IP API request rate limit per rolling minute
API_RATE_LIMIT_PER_MINUTE=600

# Expo Push API endpoint for mobile notifications
EXPO_PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send

# Optional Expo Push access token (or use _FILE)
EXPO_PUSH_ACCESS_TOKEN=

# Path to file containing EXPO_PUSH_ACCESS_TOKEN (Docker secret)
EXPO_PUSH_ACCESS_TOKEN_FILE=

# Monthly per-workspace price in USD cents (default 1000 = $10/workspace)
BILLING_WORKSPACE_PRICE_USD_CENTS=1000

# Live USD base FX rate endpoint for local RWF conversion
BILLING_FX_API_URL=https://open.er-api.com/v6/latest/USD

# Fallback USD->RWF exchange rate used only when live FX fetch is unavailable
BILLING_USD_TO_RWF_FALLBACK=1400

# Polar REST API base URL for international card checkouts
POLAR_API_URL=https://api.polar.sh

# Polar organization access token for HURIRO_MODE=cloud billing (or use _FILE)
POLAR_ACCESS_TOKEN=

# Path to file containing POLAR_ACCESS_TOKEN (Docker secret)
POLAR_ACCESS_TOKEN_FILE=

# Polar Standard Webhooks signing secret for HURIRO_MODE=cloud (or use _FILE)
POLAR_WEBHOOK_SECRET=

# Path to file containing POLAR_WEBHOOK_SECRET (Docker secret)
POLAR_WEBHOOK_SECRET_FILE=

# Polar product ID representing the $10/workspace Cloud plan
POLAR_PRODUCT_ID=

# IremboPay REST API base URL for Rwanda local RWF & Mobile Money payments
IREMBOPAY_API_URL=https://api.irembopay.com

# IremboPay API secret key for HURIRO_MODE=cloud billing (or use _FILE)
IREMBOPAY_SECRET_KEY=

# Path to file containing IREMBOPAY_SECRET_KEY (Docker secret)
IREMBOPAY_SECRET_KEY_FILE=

# IremboPay webhook signing secret for HURIRO_MODE=cloud (or use _FILE)
IREMBOPAY_WEBHOOK_SECRET=

# Path to file containing IREMBOPAY_WEBHOOK_SECRET (Docker secret)
IREMBOPAY_WEBHOOK_SECRET_FILE=

# Delimiter between timestamp and payload in irembopay-signature HMAC verification
IREMBOPAY_WEBHOOK_DELIMITER=#

# IremboPay merchant payment account identifier
IREMBOPAY_PAYMENT_ACCOUNT_ID=

# IremboPay product code registered for Huriro Cloud Workspace
IREMBOPAY_PRODUCT_CODE=
