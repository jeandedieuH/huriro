{
	"name": "@huriro/mobile",
	"version": "0.0.0",
	"private": true,
	"description": "Huriro Expo SDK 58 + React Native 0.88 mobile client (§18)",
	"type": "module",
	"main": "expo-router/entry",
	"dependencies": {
		"@gorhom/bottom-sheet": "5.2.14",
		"@huriro/contracts": "workspace:*",
		"@huriro/design-tokens": "workspace:*",
		"@huriro/domain": "workspace:*",
		"@huriro/editor": "workspace:*",
		"@huriro/env": "workspace:*",
		"@huriro/i18n": "workspace:*",
		"@huriro/sync-client": "workspace:*",
		"@shopify/flash-list": "2.3.2",
		"@tiptap/core": "3.34.0",
		"@tiptap/react": "3.34.0",
		"axios": "^1.21.1",
		"expo": "58.0.26",
		"expo-apple-authentication": "^58.0.3",
		"expo-blur": "58.0.6",
		"expo-constants": "58.0.16",
		"expo-linking": "58.0.17",
		"expo-notifications": "58.1.9",
		"expo-router": "58.0.32",
		"expo-secure-store": "58.0.3",
		"expo-splash-screen": "^58.0.14",
		"expo-sqlite": "58.0.18",
		"expo-status-bar": "58.0.5",
		"heroui-native": "1.0.11",
		"lucide-react-native": "1.75.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-native": "0.88.1",
		"react-native-gesture-handler": "~3.3.0",
		"react-native-keyboard-controller": "1.22.7",
		"react-native-mmkv": "^4.3.2",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "5.11.1",
		"react-native-screens": "4.30.1",
		"react-native-svg": "15.16.0",
		"react-native-webview": "14.0.1",
		"react-native-worklets": "0.13.0",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.1.18",
		"uniwind": "1.14.0",
		"zod": "^4.6.7",
		"zustand": "5.1.0"
	},
	"devDependencies": {
		"@types/react": "~19.3.0",
		"@types/react-dom": "~19.3.0"
	},
	"scripts": {
		"dev": "expo start",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "bun test",
		"prebuild-a": "expo prebuild -p android",
		"prebuild-i": "expo prebuild -p ios",
		"prebuild-all": "expo prebuild -p all",
		"eas:dev-a": "eas build -p android --profile development",
		"eas:dev-i": "eas build -p ios --profile development",
		"eas:prod-a": "eas build -p android --profile production",
		"eas:prod-i": "eas build -p ios --profile production",
		"eas:submit-a": "eas submit -p android --profile production",
		"eas:submit-i": "eas submit -p ios --profile production",
		"build": "bun scripts/verify-config.ts",
		"gen": "bun scripts/genenv.ts",
		"gen:check": "bun scripts/genenv.ts --check"
	}
}
