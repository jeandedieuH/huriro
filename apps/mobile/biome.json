{
	"root": false,
	"extends": ["../../packages/config/biome.base.json"],
	"files": {
		"includes": [
			"app",
			"src",
			"scripts",
			"app.config.ts",
			"babel.config.js",
			"metro.config.js",
			"global.css",
			"!.expo",
			"!android",
			"!ios",
			"!dist",
			"!src/uniwind-types.d.ts"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"rules": {
			"correctness": {
				"noReactNativeRawText": {
					"level": "error",
					"options": {
						"skip": [
							"Alert.Description",
							"Alert.Title",
							"Avatar.Fallback",
							"Button.Label",
							"Card.Description",
							"Card.Title",
							"Chip.Label",
							"FieldError",
							"Label",
							"Label.Text"
						]
					}
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["scripts/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": ["src/components/docs/**"],
			"linter": {
				"rules": {
					"correctness": {
						"noReactNativeRawText": "off"
					}
				}
			}
		}
	]
}
