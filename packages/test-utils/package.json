{
	"name": "@huriro/test-utils",
	"version": "0.0.0",
	"private": true,
	"description": "Factories, Testcontainers harness, RLS/two-tenant fixtures (§21.3)",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"default": "./src/*.ts"
		}
	},
	"dependencies": {
		"@huriro/db": "workspace:*",
		"@huriro/domain": "workspace:*",
		"postgres": "4.1.1",
		"testcontainers": "12.2.1",
		"@testcontainers/postgresql": "12.2.1"
	},
	"scripts": {
		"lint": "biome check .",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "bun test --timeout 120000"
	}
}
