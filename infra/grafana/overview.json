{
	"__inputs": [
		{
			"name": "DS_PROMETHEUS",
			"label": "Prometheus",
			"type": "datasource",
			"pluginId": "prometheus"
		}
	],
	"title": "Huriro — Platform Overview & GA SLOs",
	"uid": "huriro-ga-overview",
	"timezone": "utc",
	"schemaVersion": 39,
	"version": 1,
	"refresh": "30s",
	"panels": [
		{
			"id": 1,
			"type": "timeseries",
			"title": "HTTP Request Latency (p50 / p95 / p99)",
			"gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
			"targets": [
				{
					"expr": "histogram_quantile(0.50, sum(rate(huriro_http_request_duration_seconds_bucket[5m])) by (le))",
					"legendFormat": "p50"
				},
				{
					"expr": "histogram_quantile(0.95, sum(rate(huriro_http_request_duration_seconds_bucket[5m])) by (le))",
					"legendFormat": "p95 (SLO < 0.2s)"
				},
				{
					"expr": "histogram_quantile(0.99, sum(rate(huriro_http_request_duration_seconds_bucket[5m])) by (le))",
					"legendFormat": "p99 (SLO < 0.5s)"
				}
			]
		},
		{
			"id": 2,
			"type": "timeseries",
			"title": "Outbox Lag & Sync Cursor Write Latency",
			"gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
			"targets": [
				{
					"expr": "huriro_outbox_pending",
					"legendFormat": "pending outbox events"
				},
				{
					"expr": "histogram_quantile(0.95, sum(rate(huriro_change_log_write_ms_bucket[5m])) by (le))",
					"legendFormat": "change_log p95 (ms)"
				}
			]
		},
		{
			"id": 3,
			"type": "timeseries",
			"title": "Realtime WebSocket & Collaborative Doc Connections",
			"gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
			"targets": [
				{
					"expr": "huriro_ws_active_connections",
					"legendFormat": "signal ws connections"
				},
				{
					"expr": "huriro_collab_active_rooms",
					"legendFormat": "collab doc rooms"
				},
				{
					"expr": "huriro_collab_active_connections",
					"legendFormat": "collab ws connections"
				}
			]
		},
		{
			"id": 4,
			"type": "timeseries",
			"title": "Chat Throughput, File Scans, & Webhook Deliveries",
			"gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
			"targets": [
				{
					"expr": "sum(rate(huriro_chat_messages_total[5m])) by (kind)",
					"legendFormat": "chat {{kind}}/s"
				},
				{
					"expr": "sum(rate(huriro_webhook_deliveries_total[5m])) by (outcome)",
					"legendFormat": "webhook {{outcome}}/s"
				},
				{
					"expr": "sum(rate(huriro_file_scans_total[5m])) by (status)",
					"legendFormat": "file scan {{status}}/s"
				}
			]
		}
	]
}
